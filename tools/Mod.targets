<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<Project>

	<PropertyGroup>
		<ModName Condition="'$(ModName)' == ''">$(Product)</ModName>
		<ModVersion Condition="'$(ModVersion)' == ''">$(Version)</ModVersion>
		<ModAuthor Condition="'$(ModAuthor)' == ''">$(Author)</ModAuthor>
		<ModGUID Condition="'$(ModGUID)' == ''">$(AssemblyName)</ModGUID>
	</PropertyGroup>

	<Target Name="GenerateModInfoHash">
		<PropertyGroup>
			<GeneratedModInfoFile>$(IntermediateOutputPath)/$(ProjectName).ModInfo.g.cs</GeneratedModInfoFile>
			<GeneratedModInfoHashFile>$(IntermediateOutputPath)/$(ProjectName).ModInfo.cache</GeneratedModInfoHashFile>
		</PropertyGroup>

		<Hash ItemsToHash="$(ModName);$(ModVersion);$(ModAuthor);$(ModGUID)">
			<Output TaskParameter="HashResult" PropertyName="_HashResult" />
		</Hash>

		<WriteLinesToFile
			Lines="$(_HashResult)"
			File="$(GeneratedModInfoHashFile)"
			Overwrite="True"
			WriteOnlyWhenDifferent="True" />

		<ItemGroup>
			<FileWrites Include="$(GeneratedModInfoHashFile)" />
		</ItemGroup>
	</Target>

	<Target Name="GenerateModInfo"
		DependsOnTargets="GenerateModInfoHash"
		AfterTargets="CoreGenerateAssemblyInfo"
		Inputs="$(GeneratedModInfoHashFile)"
		Outputs="$(GeneratedModInfoFile)"
	>
		<!--
			Annoying as hell doing it like this, but source generators don't have access to
			build property values that are set/updated via tasks (like the version)
		-->
		<PropertyGroup>
			<FileContent><![CDATA[// <auto-generated />
#nullable enable

namespace $(RootNamespace)%3B

public partial class Mod
{
	public const string Name = "$(ModName)"%3B
	public const string Version = "$(ModVersion)"%3B
	public const string Author = "$(ModAuthor)"%3B
	public const string GUID = "$(ModGUID)"%3B
}
]]>
			</FileContent>
		</PropertyGroup>

		<ItemGroup>
			<Compile Include="$(GeneratedModInfoFile)" />
			<FileWrites Include="$(GeneratedModInfoFile)" />
		</ItemGroup>

		<WriteLinesToFile
			Lines="$(FileContent)"
			File="$(GeneratedModInfoFile)"
			Overwrite="True"
			WriteOnlyWhenDifferent="True" />
	</Target>

</Project>
