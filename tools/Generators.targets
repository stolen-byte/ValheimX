<Project>

	<PropertyGroup>
		<ModName Condition="'$(ModName)' == ''">$(Product)</ModName>
		<ModVersion Condition="'$(ModVersion)' == ''">$(Version)</ModVersion>
		<ModAuthor Condition="'$(ModAuthor)' == ''">$(Author)</ModAuthor>
		<ModGUID Condition="'$(ModGUID)' == ''">$(AssemblyName)</ModGUID>
	</PropertyGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="ModName" />
		<CompilerVisibleProperty Include="ModVersion" />
		<CompilerVisibleProperty Include="ModAuthor" />
		<CompilerVisibleProperty Include="ModGUID" />
	</ItemGroup>

</Project>
