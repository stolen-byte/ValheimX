<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<EmitCompilerGeneratedFiles Condition="'$(Configuration)' == 'Debug'">true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ToolsRoot)\Tasks\Tasks.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Generators\Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fody" PrivateAssets="All">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="InlineIL.Fody" PrivateAssets="All" />
    <PackageReference Include="PolySharp" IncludeAssets="all" PrivateAssets="All" />
  </ItemGroup>

  <Import Project="$(ToolsRoot)/References.targets" />
  <Import Project="$(ToolsRoot)/Mod.targets" />

</Project>
