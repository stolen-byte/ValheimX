#############################################
### C# Analyzer Rules
#############################################
[*.{cs,csx,cake}]
# Mark assemblies as CLSCompliant
dotnet_diagnostic.CA1014.severity=silent

# Validate public method parameters for null
#   Obsolete now with Nullable References
#dotnet_code_quality.null_check_validation_methods = NotNull
dotnet_diagnostic.CA1062.severity = none

# Implement IDisposable Correctly:
# and
# Dispose() should call GC.SuppressFinalize()
#   a lot of the really overly-complex IDisposable documentation is because they assume your class
#   will want to handle both managed and unmanaged resources. This is a holdover from .NET 1.0, and it’s kept
#   only for backwards compatibility. Microsoft themselves don’t even follow that old pattern
#   (they were changed in .NET 2.0).
#   Some analyzers will yell at you because you need to implement IDisposable "correctly" (i.e., using the old pattern);
#   ignore then - they're wrong.
dotnet_diagnostic.CA1063.severity = none
dotnet_diagnostic.CA1816.severity = none

# Disable XML documentation warnings
dotnet_diagnostic.CS1591.severity = none

#############################################
### Silly Rules
#############################################

# Avoid out parameters
# 	they're just 'ref' with forced assignment, no reason to "avoid" them
dotnet_diagnostic.CA1021.severity=silent

# Implement standard exception constructors
dotnet_diagnostic.CA1032.severity = none

# Do not catch general exception types
dotnet_diagnostic.CA1031.severity = none

# Do not ignore method results:
dotnet_diagnostic.CA1806.severity = none

# prefer jagged arrays to multidimensional:
dotnet_diagnostic.CA1814.severity = none

# Enum Storage should be Int32
dotnet_diagnostic.CA1028.severity = none

# Mark members as static
dotnet_diagnostic.CA1822.severity = none

# Type names should not match namespaces
dotnet_diagnostic.CA1724.severity = none

# Use events where appropriate
dotnet_diagnostic.CA1030.severity = none

# Identifier contains type name
dotnet_diagnostic.CA1720.severity = none

# Slice can be simplified (Slice() -> range operator)
# Range operator is not always better, as it currently adds extra unecessary code
# and can also impact readability
dotnet_diagnostic.IDE0057.severity = silent

# Namespace <...> does not match folder structure
dotnet_diagnostic.IDE0130.severity = none
