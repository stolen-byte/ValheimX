<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <BuildToolsVersion>18.9.6</BuildToolsVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Fody" Version="6.9.3" />
    <PackageVersion Include="InlineIL.Fody" Version="1.10.2" />
    <PackageVersion Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="$(BuildToolsVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Semver" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup Label="Configure">
    <PackageVersion Include="BepInEx.AssemblyPublicizer" Version="0.4.3" />
    <PackageVersion Include="Microsoft.Build" Version="$(BuildToolsVersion)" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="$(BuildToolsVersion)" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>